# Explicit allowlist. Never publish textbook pages, private notes or local tools.
*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/CREDITS.md
!/VIDEO-SOURCES.md
!/package.json
!/package-lock.json
!/game.html
!/math.js
!/miso*.js
!/miso*.css
/miso-youtube.js
!/assets/
/assets/*
!/assets/miso-no-glasses.png
!/assets/miso-petted-no-glasses.png
!/assets/purr.ogg
!/assets/voice-sonia/
/assets/voice-sonia/*
!/assets/voice-sonia/*.mp3
!/tests/
/tests/*
!/tests/*.cjs
/tests/browser.test.cjs
/tests/game.test.cjs
/tests/miso-youtube.test.cjs
!/tools/
/tools/*
!/tools/release/
/tools/release/*
!/tools/release/*.cjs
!/tools/narration/
/tools/narration/*
!/tools/narration/prepare-free.cjs
!/tools/narration/generate-free.py
!/tools/narration/requirements-free.txt
!/docs/
!/docs/**
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml

# Defence in depth, including generated output.
**/node_modules/
**/.venv/
**/__pycache__/
**/.env*
**/*.pdf
**/*.jp2
**/*.pem
**/*.key
**/source-review*/
**/*.log
